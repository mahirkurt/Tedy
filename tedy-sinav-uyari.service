[Unit]
Description=TEDY sınav uyarıları (web push turu)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/mnt/thunderbolt/workspaces/TED
Environment=PATH=/mnt/thunderbolt/workspaces/TED/.venv/bin:/usr/bin:/bin
# Istanbul time, not the host's UTC: see src/env_loader.py. TZ must never be
# put in .env: EnvironmentFile= overrides Environment= whatever the line order.
Environment=TZ=Europe/Istanbul
EnvironmentFile=/mnt/thunderbolt/workspaces/TED/.env
ExecStart=/mnt/thunderbolt/workspaces/TED/.venv/bin/python -m src.sinav_uyari gonder
# Devices are sent to one by one, each with a 10 s request timeout (plus the
# pending retries): a round with many devices and slow push services needs room.
TimeoutStartSec=600
